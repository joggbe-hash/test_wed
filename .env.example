# Public URL of the deployed site, including any base path.
VITE_SITE_URL=https://example.com/
VITE_BASE_PATH=/

# Leave empty when the API is served from the same origin.
VITE_API_BASE_URL=

# Optional local-development proxy target. The browser still calls same-origin /api/*.
VITE_DEV_API_TARGET=http://127.0.0.1:5000
