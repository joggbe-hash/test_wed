# === PostgreSQL ===
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB_SYSTEM=system_db
POSTGRES_DB_USER=user_db
# The bundled PostgreSQL container uses the internal Docker network without TLS.
# Use verify-full when connecting to a TLS-enabled external database.
POSTGRES_SSLMODE=disable

# === Redis ===
REDIS_PASSWORD=change_me_redis_password

# === MinIO ===
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=uploads
# Set true when MINIO_ENDPOINT uses TLS.
MINIO_SECURE=false

# === API runtime ===
SERVER_NAME=localhost
API_PORT=5000
SESSION_TTL_SECONDS=86400
SECRET_KEY=replace_with_at_least_32_random_bytes
# Verification codes are never returned unless both values explicitly opt into local development.
APP_ENV=production
EXPOSE_VERIFICATION_CODE=false
